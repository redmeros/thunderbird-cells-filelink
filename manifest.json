{
  "manifest_version": 3,
  "name": "Cells FileLink",
  "version": "1.0.1",
  "description": "Send large attachments as download links via a Pydio Cells server.",
  "browser_specific_settings": {
    "gecko": {
      "id": "cells-filelink@example.com",
      "strict_min_version": "128.0"
    }
  },
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://cells.example.com/*"],
  "cloud_file": {
    "name": "Pydio Cells",
    "management_url": "management/management.html",
    "reuse_uploads": true
  },
  "icons": {
    "16": "icons/icon.svg",
    "32": "icons/icon.svg",
    "64": "icons/icon.svg"
  }
}
